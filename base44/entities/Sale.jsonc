{
  "name": "Sale",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Product ID"
    },
    "product_name": {
      "type": "string",
      "title": "Product Name"
    },
    "vendor_name": {
      "type": "string",
      "title": "Vendor Name"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity Sold",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "title": "Unit Price (NLe)"
    },
    "total_price": {
      "type": "number",
      "title": "Total Price (NLe)"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "quantity",
    "total_price"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}